ENV_FILE=.env.paper
ENVIRONMENT=paper
TRADING_MODE=PAPER
LIVE_ORDERS_ENABLED=0
OKX_EXECUTION_ENABLED=0
QUOTE_ASSET=USDC
DEFAULT_SYMBOL=BTCUSDC
BINANCE_MYTRADES_ENABLED=0

# public hosts
PUBLIC_LIVE_HOST=beata.waltrade-bot.com
PUBLIC_PAPER_HOST=paper-beata.waltrade-bot.com

POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass
POSTGRES_DB=trading_paper

DB_HOST=db
DB_PORT=5432
DB_NAME=trading_paper
DB_USER=botuser
DB_PASS=botpass
DB_VOLUME_NAME=trading_paper_db_data
DB_CONNECT_MAX_WAIT_SECONDS=60

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Regime
REGIME_ENABLED=1
REGIME_MODE=DRY_RUN
REGIME_MAX_AGE_SECONDS=900
REGIME_LOOKBACK=200
REGIME_TREND_EMA_FAST=21
REGIME_TREND_EMA_SLOW=100
REGIME_VOL_ATR_PERIOD=14
REGIME_VOL_THRESHOLD_PCT=0.08
REGIME_SHOCK_Z=3.0
REGIME_TREND_MIN_STRENGTH_PCT=0.05
REGIME_INTERVALS=1m,5m
REGIME_SYMBOLS=BTCUSDC,ETHUSDC,SOLUSDC,BNBUSDC
REGIME_SLEEP_SECONDS=60

# Fees
PAPER_SIMULATION_FEE_RATE=0.0035
PAPER_SLIPPAGE_RATE=0.0002

# Paper UI
VITE_API_BASE_URL=/api

INTERNAL_API_BASE=http://paper-api:8000
AI_TUNE_INTERVAL_MINUTES=4320
AI_AUTO_APPLY=false
VITE_QUOTE_ASSET=USDC
VITE_API_BASE_URL_LIVE=/api
VITE_API_BASE_URL_PAPER=/api

# paper -> live bridge
LIVE_API_BASE=http://live-api:8000

# cors
ALLOWED_ORIGINS=https://paper-beata.waltrade-bot.com,https://beata.waltrade-bot.com

# auth/session
SESSION_COOKIE_NAME=trading_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# automation-runner (DISABLE ONLY)
AUTOMATION_ENABLED=1
AUTOMATION_MODE=DISABLE_ONLY
AUTOMATION_TICK_SECONDS=60

IP_PANIC_WATCH_ENABLED=1
IPIFY_URL=https://api.ipify.org
IP_CHECK_INTERVAL_SECONDS=60

REGIME_WATCHDOG_ENABLED=1
REGIME_WATCH_INTERVAL_SECONDS=60
REGIME_LAG_MAX_1M_SECONDS=420
REGIME_LAG_MAX_5M_SECONDS=1200

DAILY_REPORT_ENABLED=1
DAILY_REPORT_HHMM_UTC=0020

ORC_ACTIONS_ENABLED=false

# Promotions publisher (PAPER -> LIVE)
PROMOTIONS_ENABLED=1
PROMOTIONS_INTERVAL_SECONDS=300
PROMOTIONS_TOP_K=20
PROMOTIONS_WINDOW_NAME=10d
PROMOTIONS_POLICY_VERSION=paper_rank_v2
PROMOTIONS_MIN_TRADES=5

SSOT_WATCHDOG_WINDOW_HOURS=48

INTERNAL_API_TOKEN=

# notifications
BACKUP_STALE_PATH=/backup-health/.last_success
BACKUP_STALE_HOURS=26
ENABLE_DAILY_PNL_SUMMARY=true
DAILY_PNL_SUMMARY_HOUR_UTC=0
PAPER_DAILY_DRAWDOWN_ALERT_USDC=-500
PAPER_DAILY_PROFIT_ALERT_USDC=500
NOTIFICATION_RETENTION_CRITICAL_DAYS=90
NOTIFICATION_RETENTION_TRADING_DAYS=30
NOTIFICATION_RETENTION_INFO_DAYS=14
NOTIFICATION_RETENTION_HARD_DELETE_DAYS=365

# app
APP_BASE_URL=https://paper-beata.waltrade-bot.com

# ORC Integration V2
# 0 = shadow only, 1 = allow automation-runner to use v_orc_integration_v2_picks for LIVE apply.
ORC_INTEGRATION_V2_APPLY_ENABLED=0


# Adaptive exit policy
# Default: no hard close only because time elapsed. Time exit remains diagnostic/watchdog only.
TIME_EXIT_POLICY=DIAGNOSTIC_ONLY
TIME_EXIT_FORCE_ENABLED=0

# FinalDecision producer denominator; enable only in a controlled rollout.
FINAL_DECISION_PRODUCER_AUDIT_LEDGER_ENABLED=0
