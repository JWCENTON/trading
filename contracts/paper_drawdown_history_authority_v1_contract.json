{
  "contract_version": "PAPER_DRAWDOWN_HISTORY_AUTHORITY_V1",
  "environment": "PAPER",
  "deployments": ["local-paper", "vps-paper"],
  "activation_table": "paper_drawdown_history_activation_v1",
  "generation_selection_table": "paper_drawdown_history_generation_selection_v1",
  "observation_table": "paper_managed_equity_observation_v1",
  "managed_equity_authority": "PORTFOLIO_STATE_V1.total_capital backed by PAPER_EQUITY_BASELINE_V2 and post-baseline Financial Truth COMPLETE",
  "managed_equity_formula": "baseline_managed_equity + post_baseline_ft_complete_net_pnl + current_unrealized_pnl - baseline_unrealized_pnl",
  "managed_equity_precision": "NUMERIC(38,18)",
  "canonical_scale": 18,
  "canonical_quantization": "PostgreSQL NUMERIC-compatible ROUND_HALF_UP (ties away from zero)",
  "exact_equality_after_canonicalization": true,
  "float_allowed": false,
  "tolerance_comparison": false,
  "raw_source_value_policy": "PRESERVE_FULL_PRECISION_PORTFOLIO_STATE_EVIDENCE_AND_FINGERPRINT_SEPARATELY",
  "economic_fingerprint_policy": "CANONICAL_NUMERIC_38_18_MANAGED_EQUITY",
  "historical_policy": "FORWARD_ONLY_NO_BACKFILL",
  "legacy_daily_snapshot_policy": "COMPATIBILITY_DIAGNOSTIC_ONLY_NOT_INGESTED",
  "cadence_seconds": 900,
  "stale_after_seconds": 1800,
  "trigger_model": ["BASELINE_ACTIVATION", "CADENCE_15M", "FINANCIAL_TRUTH_COMPLETE"],
  "financial_truth_trigger_policy": "COALESCED_LATEST_COMPLETE_ACTIVITY_SINCE_LAST_OBSERVATION",
  "flow_adjustment_required": false,
  "flow_adjustment_formula": "A_i = E_i",
  "baseline_adjusted_point": "A_0 = baseline_managed_equity",
  "running_peak_formula": "P_i = max(A_0 ... A_i)",
  "current_drawdown_abs_formula": "A_current - P_current",
  "current_drawdown_pct_formula": "(A_current - P_current) / P_current * 100",
  "max_drawdown_abs_formula": "min(A_i - P_i)",
  "max_drawdown_pct_formula": "min((A_i - P_i) / P_i * 100)",
  "drawdown_sign": "NON_POSITIVE",
  "arithmetic": ["PostgreSQL NUMERIC", "Python Decimal"],
  "incomplete_observation_policy": "DO_NOT_PERSIST_AND_DO_NOT_CONTRIBUTE",
  "gap_policy": "FAIL_CLOSED_OBSERVATION_GAP",
  "observation_idempotency": "UNIQUE observation_identity derived from activation id/generation, baseline, trigger bucket/reference and canonical NUMERIC(38,18) managed-equity fingerprint; raw Portfolio State provenance remains separately fingerprinted and conflicting evidence fails closed",
  "activation_policy": "IMMUTABLE_EXPLICITLY_SELECTED_FORWARD_GENERATION_WITH_CANONICAL_15_MINUTE_CUTOVER_BOUNDARY",
  "activation_generations_supported": true,
  "generation_one_adoption_policy": "EXISTING_ACTIVATION_AND_OBSERVATIONS_ADOPTED_BY_METADATA_DEFAULT_WITHOUT_ECONOMIC_REWRITE",
  "generations_immutable": true,
  "active_generation_selection": "SOLE_VALID_APPEND_ONLY_SELECTION_CHAIN_HEAD",
  "active_generation_ambiguity_policy": "FAIL_CLOSED",
  "approved_supersession_reasons": [
    "FAILED_INITIAL_FORWARD_ACTIVATION_AFTER_PRECISION_DEFECT",
    "PRECISION_DEFECT_RECOVERY",
    "UPSTREAM_REPLAY_CUTOVER_EPOCH_CHANGE",
    "AUTHORITY_ACTIVATION_FAILURE_RECOVERY"
  ],
  "joint_authority_epoch_contract": "JOINT_AUTHORITY_EPOCH_V1",
  "new_generation_activation_atomicity": "GENERATION_PLUS_CANONICAL_SEED_PLUS_SELECTION_PLUS_EPOCH_SELECTION",
  "cross_generation_history_merge": false,
  "observation_backfill": false,
  "baseline_reset_required_for_generation_switch": false,
  "producer_consumes_active_generation_only": true,
  "default_read_consumes_active_generation_only": true,
  "risk_budget_consumes_active_generation_only": true,
  "readiness_dimensions": [
    "AUTHORITY_READY",
    "CONTINUITY_READY",
    "EPISODE_READY",
    "MARKET_COVERAGE_READY",
    "SHADOW_OUTCOME_READY",
    "FINANCIAL_MODEL_STABLE",
    "ACCOUNTING_READY",
    "CALIBRATION_READY"
  ],
  "numeric_sufficiency_thresholds": false,
  "risk_budget_execution_influence": false,
  "paper_controlled_influence_ready": false,
  "ordinary_reads_write": false,
  "append_only": true,
  "fallbacks": false
}
