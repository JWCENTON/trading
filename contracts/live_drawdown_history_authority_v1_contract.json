{
  "contract_version": "LIVE_DRAWDOWN_HISTORY_AUTHORITY_V1",
  "environment": "LIVE",
  "deployments": ["local-live", "vps-live"],
  "managed_equity_authority": "PORTFOLIO_STATE_V1.total_capital backed by LIVE_MANAGED_CAPITAL_AUTHORITY_V1",
  "observation_table": "live_managed_equity_observation_v1",
  "historical_policy": "FORWARD_ONLY_NO_BACKFILL",
  "cadence_seconds": 900,
  "stale_after_seconds": 1800,
  "trigger_model": [
    "CADENCE_15M",
    "OWNER_CAPITAL_FLOW",
    "FINANCIAL_TRUTH_COMPLETE"
  ],
  "pending_observation_policy": "CAPTURE_IMMUTABLE_IN_PROCESS_AND_PERSIST_ONLY_AFTER_OWNER_FLOW_WATERMARK_COVERS_OBSERVED_AT",
  "owner_flow_authority": "OWNER_CAPITAL_FLOW_CANONICAL_SYNC_AUTHORITY_V1",
  "owner_flow_required_status": "CANONICAL",
  "flow_adjustment_formula": "A_i = E_i - I_i + O_i",
  "baseline_adjusted_point": "A_0 = baseline_managed_equity",
  "running_peak_formula": "P_i = max(A_0 ... A_i)",
  "current_drawdown_abs_formula": "A_current - P_current",
  "current_drawdown_pct_formula": "(A_current - P_current) / P_current * 100",
  "max_drawdown_abs_formula": "min(A_i - P_i)",
  "max_drawdown_pct_formula": "min((A_i - P_i) / P_i * 100)",
  "drawdown_sign": "NON_POSITIVE",
  "arithmetic": ["PostgreSQL NUMERIC", "Python Decimal"],
  "recovery_statuses": [
    "NO_HISTORY",
    "NO_DRAWDOWN",
    "IN_DRAWDOWN",
    "RECOVERED"
  ],
  "history_statuses": [
    "CANONICAL",
    "NO_BASELINE",
    "NO_HISTORY",
    "STALE_HISTORY",
    "OBSERVATION_GAP",
    "INCOMPLETE_PORTFOLIO_STATE",
    "INCOMPLETE_MARK",
    "INCOMPLETE_FINANCIAL_TRUTH",
    "INCOMPLETE_CAPITAL_FLOW",
    "ACCOUNT_IDENTITY_MISMATCH",
    "SOURCE_FINGERPRINT_MISMATCH",
    "ZERO_PEAK_PERCENT_UNAVAILABLE"
  ],
  "incomplete_observation_policy": "DO_NOT_PERSIST_AND_DO_NOT_CONTRIBUTE",
  "late_event_policy": "OBSERVATIONS_AT_OR_AFTER_AFFECTED_FROM_CAPTURED_BEFORE_RECONCILIATION_RESOLUTION_ARE_PERMANENTLY_EXCLUDED;NEW_POST_RESOLUTION_OBSERVATION_IS_REEMISSION",
  "observation_idempotency": "UNIQUE observation_identity derived from baseline, deterministic cadence/event trigger and trigger reference; conflicting evidence fails closed",
  "ordinary_portfolio_state_reads_write": false,
  "append_only": true,
  "risk_budget_policy": false,
  "fallbacks": false
}
