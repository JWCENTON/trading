{
  "contract": "PORTFOLIO_STATE_V1_CONTRACT",
  "version": "PORTFOLIO_STATE_V1",
  "capital_scope": "MANAGED_PORTFOLIO_EQUITY",
  "environment_identity": {
    "allowed": {
      "local-live": "LIVE",
      "local-paper": "PAPER",
      "vps-live": "LIVE",
      "vps-paper": "PAPER"
    },
    "mismatch": "FAIL_CLOSED"
  },
  "fields": {
    "portfolio_state_version": {"type": "string", "null": false, "unit": null, "authority": "PORTFOLIO_STATE_V1"},
    "environment": {"type": "enum[PAPER,LIVE]", "null": false, "unit": null, "authority": "explicit runtime identity"},
    "deployment_id": {"type": "enum[local-paper,local-live,vps-paper,vps-live]", "null": false, "unit": null, "authority": "explicit runtime identity"},
    "as_of": {"type": "timestamptz", "null": false, "unit": "UTC", "authority": "caller-supplied declared replay boundary; generated at read start only for current/no-as-of reads"},
    "runtime_revision": {"type": "string", "null": true, "unit": null, "authority": "GIT_SHA"},
    "total_capital": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "PAPER: PAPER_EQUITY_BASELINE_V2 forward equation; LIVE: LIVE_MANAGED_CAPITAL_AUTHORITY_V1 raw managed-scope OKX balances marked to USDC"},
    "available_capital": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "PAPER: NONE_V1/INCOMPLETE; LIVE: raw OKX USDC availBal minus CAPITAL_RESERVATION_AUTHORITY_V1 INTERNAL_UNREFLECTED reservations"},
    "reserved_capital": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "CAPITAL_RESERVATION_AUTHORITY_V1 current active ENTRY remaining_reserved_notional"},
    "deployed_capital": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "current: positions.remaining_inventory_qty; PAPER historical: canonical ENTRY minus EXIT fills through declared as_of; multiplied by fresh candles.close"},
    "realized_pnl": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "canonical_financial_truth_v1 COMPLETE after accepted cutover"},
    "unrealized_pnl": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "current inventory, or PAPER historical canonical fill inventory and weighted entry basis through declared as_of, marked with fresh candles.close"},
    "open_positions_count": {"type": "integer", "null": false, "unit": "positions", "authority": "current: positions.status=OPEN; PAPER historical: positive canonical fill inventory through declared as_of"},
    "open_exposure_notional": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "same as deployed_capital"},
    "exposure_by_symbol": {"type": "ExposureBucket[]", "null": false, "unit": "symbol base quantity and USDC", "authority": "canonical open inventory and fresh mark"},
    "exposure_by_strategy": {"type": "ExposureBucket[]", "null": false, "unit": "USDC; quantity null because heterogeneous base assets are not additive", "authority": "canonical open inventory and fresh mark"},
    "exposure_by_regime": {"type": "ExposureBucket[]", "null": false, "unit": "USDC; quantity null because heterogeneous base assets are not additive", "authority": "market_regime CANONICAL_REGIME_ATTRIBUTION_V1; missing key=UNKNOWN"},
    "open_risk": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "POSITION_RISK_BOUNDARY_AUTHORITY_V1 + frozen LIVE_EXIT_COST_AUTHORITY_V1; all material positions must be canonical"},
    "position_risk": {"type": "PositionRiskEvidence[]", "null": false, "unit": "USDC", "authority": "per-position POSITION_RISK_BOUNDARY_AUTHORITY_V1 evidence"},
    "material_risk_position_count": {"type": "integer", "null": false, "unit": "positions", "authority": "canonical open inventory"},
    "canonical_risk_position_count": {"type": "integer", "null": false, "unit": "positions", "authority": "per-position canonical risk evidence"},
    "covered_exposure": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "diagnostic only; fresh-mark exposure for canonical-risk positions"},
    "partial_risk_sum": {"type": "Decimal", "null": true, "unit": "USDC", "authority": "diagnostic only; never aggregate authority when coverage is incomplete"},
    "portfolio_heat": {"type": "Decimal", "null": true, "unit": null, "authority": "NONE_V1"},
    "drawdown": {"type": "Decimal", "null": true, "unit": "percent", "authority": "accepted-baseline-aligned managed equity and equity_daily_snapshot_v1"}
  },
  "status_vocabulary": ["CANONICAL", "CANONICAL_EMPTY", "INCOMPLETE", "PRICE_STALE", "PRICE_UNAVAILABLE", "NOT_YET_CANONICAL", "RECONCILIATION_FAILED", "MISSING_BOUNDARY", "MISSING_POSITION_LINKAGE", "MISSING_ENTRY_BASIS", "MISSING_MARK", "STALE_MARK", "MISSING_COST_AUTHORITY", "MISSING_EXIT_COST_AUTHORITY", "STALE_FEE_EVIDENCE", "ACCOUNT_IDENTITY_MISMATCH", "INSTRUMENT_MISMATCH", "INVENTORY_DATA_QUALITY_ERROR", "BOUNDARY_INVALID", "BOUNDARY_BREACHED_UNRESOLVED"],
  "price_contract": {
    "authority": "candles.close",
    "timestamp": "candles.open_time",
    "freshness": "20 minutes",
    "missing_semantics": "NULL/PRICE_UNAVAILABLE",
    "stale_semantics": "NULL/PRICE_STALE",
    "entry_price_fallback": false
  },
  "equations": {
    "paper_managed_equity": "baseline_managed_equity + post_baseline_FT_COMPLETE_net_pnl + current_unrealized_pnl - baseline_unrealized_pnl",
    "deployed_capital": "sum(abs(remaining_inventory_qty * fresh_mark_price))",
    "unrealized_long": "(fresh_mark_price - entry_price) * remaining_inventory_qty",
    "unrealized_short": "(entry_price - fresh_mark_price) * remaining_inventory_qty",
    "drawdown_pct": "(current_managed_equity - max_managed_equity_since_accepted_baseline) / max_managed_equity_since_accepted_baseline * 100",
    "reserved_is_not_inventory": true,
    "available_is_not_inferred": true,
    "reserved_capital": "sum(CAPITAL_RESERVATION_AUTHORITY_V1 remaining_reserved_notional for active ENTRY reservations)",
    "live_available_capital": "raw_usdc_avail_bal - internal_unreflected_reserved; exchange-reflected reservation is not subtracted twice",
    "open_risk_core": "(fresh_mark_price - frozen_boundary_price) * remaining_inventory_qty for SPOT LONG and mark > boundary",
    "live_exit_fee_estimate": "frozen_boundary_price * remaining_inventory_qty * frozen canonical taker fee rate",
    "open_risk_aggregate": "sum canonical per-position risk including authoritative exit cost only when every positive-inventory position is canonical; no material inventory=0/CANONICAL_EMPTY",
    "material_position": "remaining_inventory_qty > 0; zero is non-contributing; null or negative fails closed",
    "boundary_breached": "NULL/BOUNDARY_BREACHED_UNRESOLVED"
  },
  "paper_historical_replay": {
    "temporal_authority": "DECLARED_AS_OF",
    "position_membership": "positive canonical simulated ENTRY quantity through as_of minus EXIT quantity through as_of",
    "current_status_dependency": false,
    "boundary": "latest append-only POSITION_RISK_BOUNDARY_AUTHORITY_V1 event effective at or before as_of",
    "exit_cost": "immutable entry opportunity evidence created and captured at or before as_of",
    "future_evidence": "INELIGIBLE",
    "current_no_as_of_path": "UNCHANGED_CURRENT_PROJECTIONS"
  },
  "live_managed_capital": {
    "contract_version": "LIVE_MANAGED_CAPITAL_AUTHORITY_V1",
    "account_scope": "DEDICATED_WALTRADE_MANAGED_ACCOUNT",
    "authority_contract": "contracts/live_managed_capital_authority_v1_contract.json",
    "current_equity": "sum(raw OKX total balance per managed asset * fresh canonical USDC mark)",
    "inventory_already_in_account_equity": true,
    "unknown_asset": "INCOMPLETE/UNCLASSIFIED_ACCOUNT_ASSET",
    "inventory_mismatch": "INCOMPLETE/INVENTORY_RECONCILIATION_INCOMPLETE",
    "available": "raw OKX USDC availBal minus canonical unreflected internal reservations",
    "available_fallback": false,
    "owner_flow_sync_authority": "OWNER_CAPITAL_FLOW_CANONICAL_SYNC_AUTHORITY_V1",
    "owner_flow_boundary": "OKX_TRADING_ACCOUNT",
    "owner_flow_equation": "flow_adjusted_equity = raw_managed_equity - canonical_transfer_in + canonical_transfer_out",
    "external_deposit_withdrawal_policy": "SOURCE_CONTEXT_ONLY_NO_MANAGED_CAPITAL_EFFECT",
    "pre_baseline_history": "excluded by accepted cutover",
    "baseline_activation": "exact immutable LIVE_MANAGED_CAPITAL_BASELINE_PLAN_V1 artifact plus fingerprint-pinned Product Owner approval",
    "unapproved_plan_consumed_by_portfolio_state": false
  },
  "capital_reservation_contract": "contracts/capital_reservation_authority_v1_contract.json",
  "position_risk_boundary_contract": "contracts/position_risk_boundary_authority_v1_contract.json",
  "live_exit_cost_contract": "contracts/live_exit_cost_authority_v1_contract.json",
  "schema_objects": [
    "live_managed_capital_baseline_v1",
    "owner_capital_flow_v1",
