    "pre_entry_exit_fee_estimate": "proposed_boundary_price * proposed_inventory_qty * canonical_exit_fee_rate",
    "total_pre_entry_risk": "pre_entry_core_price_risk + pre_entry_exit_fee_estimate",
    "arithmetic": "PostgreSQL Numeric / Python Decimal; binary float forbidden"
  },
